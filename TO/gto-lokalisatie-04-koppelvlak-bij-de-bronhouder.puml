@startuml
!include <archimate/Archimate>
!include ../publish/plantuml-style.puml
title Koppelvlak bij de bronhouder

skinparam nodesep 22
skinparam ranksep 38

Application_Component(client, "Lokalisatieclient")

rectangle "Bronhoudende zorgaanbieder" as bron {
  Application_Interface(oauth, "OAuth 2.0\ntoken-endpoint")
  Application_Interface(api, "Zorgaanbieder-\nendpoint\n(FHIR)")
}

rectangle "Nog in te vullen" as extern {
  Application_Component(gfautz, "GF Autorisatie")
}

Rel_Serving(oauth, client, "access token")
Rel_Serving(api, client, "levert (meta)gegevens")
Rel_Serving(gfautz, api, "autoriseert\nverstrekking")

Lay_D(client, bron)
Lay_R(bron, extern)
@enduml
