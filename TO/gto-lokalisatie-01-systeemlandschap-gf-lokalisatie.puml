@startuml
!include <archimate/Archimate>
!include ../publish/plantuml-style.puml
title Systeemlandschap GF Lokalisatie

skinparam nodesep 25
skinparam ranksep 35

rectangle "Bij de raadplegende zorgaanbieder" as z {
  Application_Component(xis, "XIS / ECD /\nPACS")
  Application_Component(search, "Localization\nSearch Client")
}

rectangle "Landelijke voorzieningen" as l {
  Application_Component(prs, "Pseudoniemen-\nregistratie-\nservice")
  Application_Component(nvi, "Nationale\nVerwijsindex")
}

rectangle "Gedelegeerd aan een\nandere generieke functie" as g {
  Application_Component(adressering, "GF\nAdressering")
  Application_Component(autorisatie, "GF\nAutorisatie")
}

rectangle "Bij de bronhoudende zorgaanbieder" as b {
  Application_Component(bronxis, "XIS / ECD / PACS\nvan de bronhouder")
  Application_Component(reg, "Localization\nRegistration Client")
  Application_Component(custodian, "Custodian\nServer")
  Application_Interface(endpoint, "Zorgaanbieder-\nendpoint")
}

Rel_Composition(xis, search, "")
Rel_Serving(search, prs, "vraagt\npseudoniem")
Rel_Serving(search, nvi, "lokaliseert")
Rel_Composition(bronxis, reg, "")
Rel_Serving(reg, prs, "vraagt\npseudoniem")
Rel_Serving(reg, nvi, "registreert,\nverwijdert")
Rel_Serving(custodian, nvi, "autorisatie-\nbeslissing\n(GF-LOC-5)")
Rel_Serving(adressering, search, "zoekt\nendpoints op")
Rel_Serving(adressering, nvi, "zoekcontext,\nendpoint bron")
Rel_Serving(autorisatie, search, "autoriseert\nde vraag")
Rel_Serving(autorisatie, nvi, "autoriseert")
Rel_Serving(autorisatie, custodian, "regels voor\nvermelding")
Rel_Serving(autorisatie, endpoint, "autoriseert\nverstrekking")
Rel_Serving(endpoint, search, "levert\n(meta)gegevens")
Rel_Composition(bronxis, custodian, "")
Rel_Composition(bronxis, endpoint, "")

Lay_D(xis, search)
Lay_D(z, l)
Lay_R(z, g)
Lay_R(g, b)
@enduml
